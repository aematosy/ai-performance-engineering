  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "CreateToken",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = JSON.parse(responseBody)\r",
                  "var access_token_response = jsonData['token']\r",
                  "\r",
                  "pm.globals.set(\"access_token\", access_token_response);\r",
                  "\r",
                  "pm.test(\"El estado del codigo es 200\",function () {\r",
                  "        pm.response.to.have.status(200)\r",
                  "})\r",
                  "\r",
                  "pm.test(\"El tipo de respuesta es menor de 500ms\",function () {\r",
                  "       pm.expect(pm.response.responseTime).to.be.below(500)\r",
                  "})\r",
                  "\r",
                  "var object_schema = {\r",
                  "  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\r",
                  "  \"type\": \"object\",\r",
                  "  \"properties\": {\r",
                  "    \"token\": {\r",
                  "      \"type\": \"string\"\r",
                  "    }\r",
                  "  },\r",
                  "  \"required\": [\r",
                  "    \"token\"\r",
                  "  ]\r",
                  "};\r",
                  "\r",
                  "tests['Valid Schema'] = tv4.validate(jsonData,  object_schema)"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\r\n    \"username\" : \"admin\",\r\n    \"password\" : \"password123\"\r\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{restfullMicroservice}}/auth",
              "host": [
                "{{restfullMicroservice}}"
              ],
              "path": [
                "auth"
              ]
            }
          },
          "response": []
        }
      ]
    },
